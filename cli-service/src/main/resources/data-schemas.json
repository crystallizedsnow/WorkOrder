{
  "work_order_page": {
    "name": "工单分页查询",
    "description": "分页查询工单列表",
    "inputSchema": {
      "pageNum": {"type": "Integer", "required": true, "description": "当前页数"},
      "pageSize": {"type": "Integer", "required": true, "description": "每页大小"},
      "id": {"type": "Long", "required": false, "description": "工单id"},
      "code": {"type": "String", "required": false, "description": "工单编号"},
      "type": {"type": "Integer", "required": false, "description": "工单类型（0需求，1故障）"},
      "title": {"type": "String", "required": false, "description": "工单标题"},
      "content": {"type": "String", "required": false, "description": "工单关键词"},
      "priorityLevel": {"type": "Integer", "required": false, "description": "优先级（0高，1中，2低）"},
      "status": {"type": "List<Integer>", "required": false, "description": "状态列表"},
      "createTimeFrom": {"type": "Long", "required": false, "description": "创建时间起"},
      "createTimeTo": {"type": "Long", "required": false, "description": "创建时间止"},
      "deadLineFrom": {"type": "Long", "required": false, "description": "截止时间起"},
      "deadLineTo": {"type": "Long", "required": false, "description": "截止时间止"}
    },
    "outputSchema": {
      "records": {"type": "List<Object>", "description": "工单列表"},
      "records[].id": {"type": "Long", "description": "工单id"},
      "records[].code": {"type": "String", "description": "工单编号"},
      "records[].type": {"type": "Integer", "description": "工单类型"},
      "records[].typeDesc": {"type": "String", "description": "工单类型描述"},
      "records[].title": {"type": "String", "description": "工单标题"},
      "records[].priorityLevel": {"type": "Integer", "description": "优先级"},
      "records[].priorityLevelDesc": {"type": "String", "description": "优先级描述"},
      "records[].status": {"type": "Integer", "description": "状态"},
      "records[].statusDesc": {"type": "String", "description": "状态描述"},
      "records[].createTime": {"type": "String", "description": "创建时间"},
      "records[].updateTime": {"type": "String", "description": "更新时间"},
      "records[].deadlineTime": {"type": "String", "description": "截止时间"}
    }
  },
