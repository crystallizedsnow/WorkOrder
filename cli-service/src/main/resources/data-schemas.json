  "work_order_create": {
    "name": "创建工单",
    "description": "新建工单",
    "inputSchema": {
      "type": {"type": "Integer", "required": true, "description": "工单类型（0需求，1故障）"},
      "title": {"type": "String", "required": true, "description": "工单标题"},
      "content": {"type": "String", "required": true, "description": "工单内容"},
      "priorityLevel": {"type": "Integer", "required": true, "description": "优先级（0高，1中，2低）"},
      "flowId": {"type": "Long", "required": true, "description": "流程ID"},
      "deadlineTime": {"type": "Long", "required": false, "description": "截止时间"},
