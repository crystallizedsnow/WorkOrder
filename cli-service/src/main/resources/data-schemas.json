  "work_order_handle": {
    "name": "工单处理",
    "description": "处理工单（分配/协助/催单/完成/确认/仍有问题）",
    "inputSchema": {
      "id": {"type": "Long", "required": false, "description": "工单ID，与工单编号二选一"},
      "code": {"type": "String", "required": false, "description": "工单编号，与工单ID二选一"},
      "handleType": {"type": "Integer", "required": true, "description": "处理类型（1分配，2协助，3催单，4完成，5确认，6仍有问题）"},
      "assignedUserId": {"type": "Long", "required": false, "description": "安排的用户ID（分配或请求协助时必填；催单、确认完成、仍有问题时不得传）"},
      "remark": {"type": "String", "required": false, "description": "操作备注（分配要求、请求协助要求或验收意见）"}
    },
    "outputSchema": {
      "success": {"type": "Boolean", "description": "处理是否成功"}
    }
  },
